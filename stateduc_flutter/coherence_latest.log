  WHERE id_camp='2' AND id_etab='22222'
    AND id_qst != '9502'
    AND UPPER(field_name) NOT IN (
      SELECT UPPER(field_name) FROM collected_data
      WHERE id_camp='2' AND id_etab='22222'
        AND id_qst='9502'
    )
    AND id IN (
      SELECT MAX(id) FROM collected_data
      WHERE id_camp='2' AND id_etab='22222'
        AND id_qst != '9502'
      GROUP BY UPPER(field_name)
    )
),
ELEVES_AGE_NIVEAU_SEXE AS (
  SELECT
    MAX(CASE WHEN UPPER(field_name)='CODE_ETABLISSEMENT' THEN field_value END) AS CODE_ETABLISSEMENT,
    MAX(CASE WHEN UPPER(field_name)='CODE_TYPE_ANNEE' THEN field_value END) AS CODE_TYPE_ANNEE,
    MAX(CASE WHEN UPPER(field_name)='CODE_ADMINISTRATIF' THEN field_value END) AS CODE_ADMINISTRATIF,
    SUM(CASE WHEN UPPER(field_name) LIKE 'CODE_TYPE_NIVEAU_%' THEN CAST(field_value AS REAL) ELSE 0 END) AS CODE_TYPE_NIVEAU
  FROM _cd
)
SELECT COUNT(*) AS cnt FROM (
SELECT CODE_TYPE_NIVEAU FROM ELEVES_AGE_NIVEAU_SEXE GROUP BY CODE_TYPE_NIVEAU
) _violations
