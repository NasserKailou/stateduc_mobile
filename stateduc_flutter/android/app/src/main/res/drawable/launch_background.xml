<?xml version="1.0" encoding="utf-8"?>
<!--
  StatEduc launch background — shown by Android while the Flutter engine loads.
  Uses the brand blue (#1565C0) with the app icon centered.
  The icon file is @mipmap/ic_launcher (already generated by flutter_launcher_icons).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid brand blue background -->
    <item>
        <color android:color="#FF1565C0"/>
    </item>
    <!-- Centered app icon (the PNG generated by flutter_launcher_icons) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
