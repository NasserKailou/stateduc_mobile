		function MiseEvidenceTablesMeres(NumTab) {
				var iTab = 0 ;				
				while ( document.getElementById( 'TableMere' + iTab ) ){
						if(iTab==NumTab){
								document.getElementById( 'TableMere' + iTab).className='Evidence_TM_Ligne'
						}
						else{
								document.getElementById( 'TableMere' + iTab).className=((iTab % 2) == 0)?'ligne-paire-left':'ligne-impaire-left';
						}
						iTab++;
				}
		}
		
		function SetClasseLigne(i_TR, old_class, new_class){
				var i_TD = 0;
				while ( document.getElementById( old_class + '_' + i_TR + '_' + i_TD ) ){
						document.getElementById( old_class + '_' + i_TR + '_' + i_TD ).className	=	new_class;
						i_TD++;
				}
		}
		
		function MiseEvidenceLigne(i_TR, nb_TR) {
				for( itr=0; itr < nb_TR; itr++ ){
						if(itr==i_TR){
								if(document.getElementById( 'ligne-paire_'+i_TR +'_0' ) ){
										SetClasseLigne(i_TR, 'ligne-paire', 'Evidence_Ligne')
								}
								else if(document.getElementById( 'ligne-impaire_'+i_TR +'_0' ) ){
										SetClasseLigne(i_TR, 'ligne-impaire', 'Evidence_Ligne')
								}
						}
						else{
								SetClasseLigne(itr, 'ligne-paire', 'ligne-paire')
								SetClasseLigne(itr, 'ligne-impaire', 'ligne-impaire')
						}
				}
		}
        derniere_ligne_en_evidence = 1000;

		function MiseEvidenceLigneFrame(i_TR, nb_TR) {
            if( derniere_ligne_en_evidence != i_TR){
                //for( itr=0; itr < nb_TR; itr++ ){
                    //if(itr==i_TR){
                    if(document.getElementById( 'ligne-paire_'+i_TR +'_0' ) ){
                            SetClasseLigne(i_TR, 'ligne-paire', 'Evidence_Ligne')
                    }
                    else if(document.getElementById( 'ligne-impaire_'+i_TR +'_0' ) ){
                            SetClasseLigne(i_TR, 'ligne-impaire', 'Evidence_Ligne')
                    }
                   // }
                   // else{
                            SetClasseLigne(derniere_ligne_en_evidence, 'ligne-paire', 'ligne-paire')
                            SetClasseLigne(derniere_ligne_en_evidence, 'ligne-impaire', 'ligne-impaire')
                   // }
                //}
                derniere_ligne_en_evidence = i_TR ;
            }
		}	
		
		function MiseEvidenceZones(NumTab, NumLi, NbTab) {
				for( iTab=0; iTab <= NbTab; iTab++ ){
						var VarLi = 0 ;				
						while ( document.getElementById( 'LigneTableMere' + iTab +'_' + VarLi ) ){
								if(VarLi==NumLi && iTab==NumTab){
										document.getElementById( 'LigneTableMere' + iTab +'_' + VarLi ).className='Evidence_Ligne'
										//document.getElementById( 'LigneTableMere' + NumTab +'_' + VarLi ).style.backgroundColor='#ffffff';
										document.getElementById( 'NumLigne' + iTab +'_' + VarLi ).value='->'
										//alert('LigneTableMere' + NumTab +'_' + VarLi)
								}
								else{
										document.getElementById( 'LigneTableMere' + iTab +'_' + VarLi ).className='Defaut_Ligne'
										document.getElementById( 'NumLigne' + iTab +'_' + VarLi ).value=VarLi+1;
								}
								VarLi++;
						}
				}
		}
		
		function MiseEvidenceLigneZone(NumTab, NumLi) {
			$("#DivTableMere" + NumTab + " .Evidence_Ligne").removeClass("Evidence_Ligne");	
			$("#LigneTableMere" + NumTab + "_" + NumLi).addClass("Evidence_Ligne");	
		}

/*
* Montre ou Cache le div ayant de préfixe nom et de numéro numero
*/
		function Montrer_Cacher_Div( nom, numero ){
				var divID = nom + numero;
				if ( document.getElementById && document.getElementById( divID ) ){ // Pour les navigateurs récents
						Obj_Div = document.getElementById( divID );
						Exist_Div  = true;
				}
				else if ( document.all && document.all[ divID ] ){ // Pour les veilles versions
						Obj_Div = document.all[ divID ];
						Exist_Div  = true;
				}
				else if ( document.layers && document.layers[ divID ] ){ // Pour les très veilles versions
						Obj_Div = document.layers[ divID ];
						Exist_Div  = true;
				}
				else   {
						Exist_Div = false;
				}
				if ( Exist_Div ){
						Obj_Div.className = ( Obj_Div.className == 'cachediv' ) ? 'montrediv' : 'cachediv';
				}
		}

/*
* Cache tous les divs ayant le même préfixe
*/
		function CacheTout( nom ){
				var NumDiv = 0;
				if ( document.getElementById ){ // Pour les navigateurs récents
						while ( document.getElementById( nom + NumDiv) ){
								SetDiv = document.getElementById( nom + NumDiv );
								if ( SetDiv && SetDiv.className != 'cachediv' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						 }
				}
				else if ( document.all ){ // Pour les veilles versions
						while ( document.all[ nom + NumDiv ] ){
								SetDiv = document.all[ nom + NumDiv ];
								if ( SetDiv && SetDiv.className != 'cachediv' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						}
				}
				else if ( document.layers ){ // Pour les très veilles versions
						while ( document.layers[ nom + NumDiv ] ){
								SetDiv = document.layers[ nom + NumDiv ];
								if ( SetDiv && SetDiv.className != 'cachediv' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						}
				}
		}

/*
* Montre tous les divs ayant le même préfixe
*/
		function MontreTout( nom ){
				var NumDiv = 0;
				if ( document.getElementById ){ // Pour les navigateurs récents
						while ( document.getElementById( nom + NumDiv) ){
								SetDiv = document.getElementById( nom + NumDiv );
								if ( SetDiv && SetDiv.className != '' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						}
				}
				else if ( document.all ){ // Pour les veilles versions
						while ( document.all[ nom + NumDiv ] ){
								SetDiv = document.all[ nom + NumDiv ];
								if ( SetDiv && SetDiv.className != '' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						 }
				 }
				else if ( document.layers ) { // Pour les très veilles versions
						while ( document.layers[ nom + NumDiv ] ){
								SetDiv = document.layers[ nom + NumDiv ];
								if ( SetDiv && SetDiv.className != '' ){
										Montrer_Cacher_Div( nom, NumDiv );
								}
								NumDiv++;
						 }
				}
		}

/*
* Inverse les divs: Cache les divs visible et montre le divs cachés :)
*/
		function InverseTout( nom ){
				var NumDiv = 0;
				if ( document.getElementById ){ // Pour les navigateurs récents
						while ( document.getElementById( nom + NumDiv ) ){
								SetDiv = document.getElementById( nom + NumDiv );
								Montrer_Cacher_Div( nom, NumDiv );
								NumDiv++;
						}
				}
				else if ( document.all ){// Pour les veilles versions
						while ( document.all[ nom + NumDiv ] ){
								SetDiv = document.all[ nom + NumDiv ];
								Montrer_Cacher_Div( nom, NumDiv );
								NumDiv++;
						}
				}
				else if ( document.layers ){ // Pour les très veilles versions
						while ( document.layers[ nom + NumDiv ] ){
								SetDiv = document.layers[ nom + NumDiv ];
								Montrer_Cacher_Div( nom, NumDiv );
								NumDiv++;
						}
				}
		}
