	var err_Ob_fields = new Array ();
	
	function are_Ob_fields_if(Ob_fields, objID, values, lib_err){
		//alert(document.form1.elements.length)
		//for (var i = 0; i < document.form1.elements.length; i++){
			//alert(document.form1.elements[i].name + '/' +document.form1.elements[i].value);
		//}
		if( (objID != '') && (values.length > 0) && (Ob_fields.length > 0)){
			
			for (var i = 0; i < values.length; i++){
				
				//alert(eval ('document.form1.'+main_field+plus_line+'.value'));
				
				if( eval ('document.getElementById("'+objID+'")')){
					//alert( 'document.getElementById("'+objID+'").value');
					eval ('var main_field = document.getElementById("'+objID+'");') ;
					var go_1 = false ;
					//
					if(main_field.value  == values[i] ){
						//alert(main_field.value + '/' + values[i]);
						if ( ( main_field.getAttribute("type") == "radio") || (main_field.getAttribute("type") == "checkbox") ) {
							if(main_field.checked){	go_1 = true ;	}
						}else{	go_1 = true ;	}
					}
					
					if(go_1 == true){
						
						for(var j = 0; j < Ob_fields.length; j++){
							//alert (main_field +' / '+list_of_values+' / '+depended_fields+' / '+bool);
							if(eval ('document.getElementById("'+Ob_fields[j]+'")')){
								var is_empty = true ;
								eval ('var obli_field = document.getElementById("'+Ob_fields[j]+'");') ;
								if ((obli_field.getAttribute("type") == "radio") || (obli_field.getAttribute("type") == "checkbox") ) {
									if(obli_field.checked){	is_empty = false;	break;	}
								}
								else if(eval ('document.getElementById("'+Ob_fields[j]+'").value != ""')){	is_empty = false ;	break;	}
								//alert(obli_field.value + '/');
								if(is_empty == true ){
									var itab = err_Ob_fields.length ;
									err_Ob_fields[itab] = Ob_fields[j] 
									//alert(err_Ob_fields[itab]);
								}
							}
						}
					}
				} 
			}
		}
		if( (err_Ob_fields.length > 0) && (is_empty == true) ){
			/*var txt_chps_err = '';
			for(var i = 0; i < err_Ob_fields.length; i++){
				txt_chps_err += ' "' + err_Ob_fields[i] + '" '	
			}*/
			do_submit = false ;
			alert(' Champ(s) Obligatoire(s) : ' + lib_err);
			mise_evidence(err_Ob_fields);
			eval('setInterval("flash2('+tab_fields+')", 700) ;');
		}
		err_Ob_fields = new Array();
	}
	
	//var tab_chp 	= new Array ("NOM_ETABLISSEMENT_0");
	function mise_evidence(tab_fields){
		
		if(tab_fields.length > 0){
			//eval('document.getElementById("'+tab_fields[0]+'").focus()');
			for (var i = 0; i < tab_fields.length; i++){
				eval ('document.getElementById("'+tab_fields[i]+'").style.border ="2px inset red"');
			}
		}
	}
	
	function flash2(tab_fields){
		//alert(' A '+ tab_fields.length);
		for (var i = 0; i < tab_fields.length; i++){
			if (eval('document.getElementById("'+tab_fields[i]+'").style.borderColor=="red"')){
				eval('document.getElementById("'+tab_fields[i]+'").style.borderColor="white"');
			}
			else{
				eval('document.getElementById("'+tab_fields[i]+'").style.borderColor="red"');
			}
		}
	}
	
	function Activation( depended_fields, objID, values, bool, op){
	
		if( (objID != '') && (values.length > 0) && (depended_fields.length > 0)){
			var found = false ;
			var opp_bool = (bool == true) ? false : true;
			
			if( eval ('document.getElementById("'+objID+'")')){
				eval ('var main_field = document.getElementById("'+objID+'");') ;
				for (var i = 0; i < values.length; i++){
				
					var go_0 = false ;
					var go_1 = false ;
					//
					if( (op != 'IN') ){
						if( main_field.value != values[i] ){
							go_0 = true ;
						}
					}else{
						if( main_field.value == values[i] ){
							go_0 = true ;
						}
					}
					//alert(main_field.value +op_ctrl+' '+values[i]); 
					if( go_0 == true ){
						
						if ( ( main_field.getAttribute("type") == "radio") || (main_field.getAttribute("type") == "checkbox") ) {
							if(main_field.checked){	go_1 = true ;	}
						}else{	go_1 = true ;	}
					}
					if(go_1 == true){
						
						for(var j = 0; j < depended_fields.length; j++){
							//alert (main_field +' / '+list_of_values+' / '+depended_fields+' / '+bool);
							if(eval ('document.getElementById("'+depended_fields[j]+'")')){
								eval ('document.getElementById("'+depended_fields[j]+'").disabled = '+bool+';');
								 Check_Hide_Obj( depended_fields[j] , opp_bool);
							}
						}
						found = true ;
						break;
					
					}
				}
				if(found == false){
					
					for(var j = 0; j < depended_fields.length; j++){
						//alert (main_field +' / '+list_of_values+' / '+depended_fields+' / '+bool);
						if(eval ('document.getElementById("'+depended_fields[j]+'")')){
							eval ('document.getElementById("'+depended_fields[j]+'").disabled = '+opp_bool+';');
							Check_Hide_Obj( depended_fields[j] , bool);
						}
					}
				}
			}
		}
	}
	
	function Check_Hide_Obj( objID , bool){
		if(bool){
			document.getElementById(objID).style.visibility = 'visible';	
		}else{
			document.getElementById(objID).style.visibility = 'hidden';
		}
	}
	function check_radio_tick(objID){
		//alert(objID);
		
		if( eval ('document.getElementById("'+objID+'")')){
			eval ('var field = document.getElementById("'+objID+'");') ;
			if ( field.getAttribute("type") == "radio") {
				
				if(field.checked){
					field.setAttribute("checked") == false ;
				}else {
					field.setAttribute("checked") == true ;	
				}
				//eval ('document.getElementById("'+objID+'").checked = 0;');
			}
		}
	}
	
	
	function open_dialog(_title, _width, _heigth, _url) {
		if ($("#bandeau").length == 0) {
			window.parent.jQuery('#div_sousdialog').dialog({
				dialogClass: "surToTop",
				draggable: true,	
				title: '_',
				width: _width,
				modal:true,
				position: { my: "center top", at: "center bottom", of: window.parent.jQuery('#bandeau')},
				open: function( event, ui ) {
					window.parent.jQuery("#sousdialog_content").attr("src", _url);
					window.parent.jQuery(".ui-widget-overlay:eq(1)").css("z-index", 1100);
					window.parent.jQuery("#sousdialog_content").load(function() {
						var hauteur = this.contentWindow.document.body.offsetHeight;
						if (hauteur < 60) {
							hauteur = _heigth - 50;
						}
						this.style.height = hauteur + 'px';
					});					
					sousdialog = true;
				},
				beforeClose: function( event, ui ) {
					sousdialog = false;
					window.parent.jQuery("#sousdialog_content").attr("src", "");
				}
			});
		} else {
			$( "#div_dialog" ).dialog({
				dialogClass: "toTop",	
				draggable: true,
				//title: _title.length==0?'_':_title,
				title: '_',
				width: _width,
				/*minHeight: _heigth,
				maxHeight: _heigth,*/
				modal:true,
				position: { my: "center top", at: "center bottom", of: $("#bandeau")},
				open: function( event, ui ) {
					$("#dialog_content").attr("src", _url);
					$('#dialog_content').load(function() {
						var hauteur = this.contentWindow.document.body.offsetHeight;
						var largeur = this.contentWindow.document.body.offsetWidth;
						if (hauteur < 60) {
							hauteur = _heigth - 50;
						}	
						if (largeur < _width) {
							largeur = _width;
						}
						if (_title == 'popinstabmere' || _title == 'popinszone') {
							hauteur = hauteur + 50;
							largeur = largeur - 30;
						}	
						this.style.height = hauteur + 'px';
						this.style.width = largeur + 'px';
					});
					//window.parent.jQuery("#div_dialog").dialog("option", "height", $(document).height()-20);
					dialog = true;
				},
				beforeClose: function( event, ui ) {
					dialog = false;
					jQuery("#dialog_content").attr("src", "");
				}
			});
		}
	}	
	
  function open_dialog_refresh(_title, _width, _heigth, _url) {
		$( "#div_dialog" ).dialog({
				dialogClass: "toTop",	
				draggable: true,
				//title: _title.length==0?'_':_title,
				title: '_',
				width: _width,
				/*minHeight: _heigth,
				maxHeight: _heigth,*/
				modal:true,
				position: { my: "center top", at: "center bottom", of: $("#bandeau")},
				open: function( event, ui ) {
					$("#dialog_content").attr("src", _url);
					$('#dialog_content').load(function() {
						var hauteur = this.contentWindow.document.body.offsetHeight;
						var largeur = this.contentWindow.document.body.offsetWidth;
						if (hauteur < 60) {
							hauteur = _heigth - 50;
						}	
						if (largeur < _width) {
							largeur = _width;
						}
						if (_title == 'popinstabmere' || _title == 'popinszone') {
							hauteur = hauteur + 50;
							largeur = largeur - 30;
						}	
						this.style.height = hauteur + 'px';
						this.style.width = largeur + 'px';
					});
					//window.parent.jQuery("#div_dialog").dialog("option", "height", $(document).height()-20);
					dialog = true;
				},
				beforeClose: function( event, ui ) {
					dialog = false;
					jQuery("#dialog_content").attr("src", "");
          window.parent.location.reload();
				},        
				close: function( event, ui ) {
          window.parent.location.reload();
				}
			});
	}	
  
	function scrollTo(target) {
	    //e.preventDefault();
		alert(target);
	    $target = $(target);
		
		if ($target == null || $target.offset() == null) {
			return false;
		}

	    $('html, body').stop().animate({
	        'scrollTop': $target.offset().top
	    }, 900, 'swing', function () {
	        window.location.hash = target;
	    });
	}
	
	/**
	 * Override javascript confirm() and wrap it into a jQuery-UI Dialog box
	 *
	 * @depends $.getOrCreateDialog
	 *
	 * @param { String } the alert message
	 * @param { String/Object } the confirm callback
	 * @param { Object } jQuery Dialog box options 
	 */
	function confirmDialog(message, callback, options) {
	 	if (options.title == '_') {
			options.title = 'StatEduc';	
		}
		var defaults = {
			modal		: true,
			resizable	: false,
			buttons		: {
				Ok: function() {
					$(this).dialog('close');
					return (typeof callback == 'string') ?
					  window.location.href = callback :
					  callback();
				},
				Cancel: function() {
					$(this).dialog('close');
					return false;
				}
			},
			show		: 'fade',
			hide		: 'fade',
			minHeight	: 50,
			dialogClass: "surToTop",
			draggable: true//,
			//position: { my: "center top", at: "center middle", of: $("body")}
		}
	 
		$confirm = $.getOrCreateDialog('confirm');	
		// set message
		$("p", $confirm).html(message);
		// init dialog
		$confirm.dialog($.extend({}, defaults, options));
	}
				
	function postChamps(service, params, callback) {
		$.ajax({type:'get', url: service, data: params, 
			success: function(response) {
				if (response.se_statut == 101) {
					if (response.se_message == 'session_end') {
						window.document.location = 'index.php';	
					} else {
						$.alert(response.se_message, '_');
					}
				} else if (response.se_statut == 200) {
					//console.log(response.se_data);
					var funcSetData = callback.bind(callback, response.se_data);
					funcSetData();
				}
			},
			error: function(XMLHttpRequest, textStatus, errorThrown) {
				$.alert('ERREUR : ' + textStatus + '-' + errorThrown, '_');        
			}, 
			dataType:'json',
			timeout: 120000
		});
	}
	
	function inArray(needle, haystack) {
		var length = haystack.length;
		for(var i = 0; i < length; i++) {
			if(haystack[i] == needle) return true;
		}
		return false;
	}